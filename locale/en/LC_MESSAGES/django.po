msgstr "Add your first memory to save your important moments."

#: .\templates\memories\memory_list.html:140
msgid "新增第一筆回憶"
msgstr "Add First Memory"

#: .\templates\places\place_list.html:17
msgid "共享地點列表"
msgstr "Shared Places"

