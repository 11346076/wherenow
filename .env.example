# ==========================================
# WhereNow Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,wherenow.nsir.uk

# Database
DB_ENGINE=mysql
DB_NAME=wherenow
DB_USER=wherenow
DB_PASSWORD=wherenow_password
DB_ROOT_PASSWORD=wherenow_root_password
DB_HOST=db
DB_PORT=3306

# Default admin account created/updated automatically on Docker startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=11346076
ADMIN_EMAIL=admin@example.com

# Google OAuth (credentials stay in env ONLY, never in DB)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Site
SITE_ID=1
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# Session (for HTTPS production: set True and None)
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://wherenow.nsir.uk

# Domain (used in Docker for the Site record)
SITE_DOMAIN=127.0.0.1:8000

# Cloudflare Tunnel (Docker: docker compose --profile tunnel up)
# Get token from Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
